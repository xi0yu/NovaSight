[Unit]
Description=NovaSight Jetson Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/novasight/current
Environment=NOVASIGHT_INSTANCE_LOCK=/run/novasight/instance.lock
EnvironmentFile=-/etc/novasight/novasight.env
RuntimeDirectory=novasight
RuntimeDirectoryMode=0755
StateDirectory=novasight
StateDirectoryMode=0750
LogsDirectory=novasight
LogsDirectoryMode=0755
ExecStartPre=/opt/novasight/current/bin/novasightd --config /etc/novasight/novasight.yaml --model-job-python /usr/bin/python3 --model-job-script /opt/novasight/current/scripts/model_ingress_job.py --model-job-workdir /var/lib/novasight --check
ExecStart=/opt/novasight/current/bin/novasightd --config /etc/novasight/novasight.yaml --model-job-python /usr/bin/python3 --model-job-script /opt/novasight/current/scripts/model_ingress_job.py --model-job-workdir /var/lib/novasight
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
