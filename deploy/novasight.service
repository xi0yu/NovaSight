[Unit]
Description=NovaSight Jetson Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/novasight
Environment=PYTHONUNBUFFERED=1
Environment=NOVASIGHT_INSTANCE_LOCK=/run/novasight/instance.lock
RuntimeDirectory=novasight
RuntimeDirectoryMode=0755
ExecStart=/opt/novasight/.venv/bin/novasight --host 0.0.0.0 --port 8000 --config /etc/novasight/novasight.yaml --data-dir /var/lib/novasight
Restart=on-failure
RestartSec=2
WatchdogSec=10
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
