[Unit]
Description=NovaSight Jetson Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/novasight/current
EnvironmentFile=-/etc/novasight/novasight.env
RuntimeDirectory=novasight
RuntimeDirectoryMode=0755
StateDirectory=novasight
StateDirectoryMode=0750
LogsDirectory=novasight
LogsDirectoryMode=0755
ExecStartPre=/opt/novasight/current/bin/novasightd --config /etc/novasight/novasight.yaml --check
ExecStart=/opt/novasight/current/bin/novasightd --config /etc/novasight/novasight.yaml
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
